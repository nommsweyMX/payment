<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#102744">
<title>Brad Michael Scalio — Payment Details</title>
<style>
:root {
  --navy:#102744; --ink:#10203a; --muted:#637083; --cream:#fbfaf7;
  --line:#d8dde6; --red:#d71932; --ltblue:#eaf5ff; --purple:#6f2bd6;
  --green:#137a3d; --amber:#9a6a00;
}
* { box-sizing:border-box; }
body {
  margin:0; background:#eef1f4; color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
}
.wrap { max-width:760px; margin:auto; background:var(--cream); min-height:100vh; }
.hero {
  min-height:305px; padding:28px 24px; display:flex; align-items:flex-end;
  background:linear-gradient(180deg,rgba(5,24,43,.02),rgba(5,24,43,.28)),
             url("data:image/jpeg;base64,") center/cover no-repeat;
}
.hero-box {
  width:min(520px,100%); padding:18px 20px; border-radius:24px;
  background:rgba(255,255,255,.90); backdrop-filter:blur(8px);
  box-shadow:0 8px 24px rgba(0,0,0,.14);
}
h1 {
  margin:0; font-family:Georgia,"Times New Roman",serif;
  font-size:clamp(34px,7vw,58px); line-height:.92; letter-spacing:.01em;
}
.addr { margin-top:14px; font-weight:750; line-height:1.35; }
.grid { padding:18px; display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.card {
  min-width:0; background:#fff; border:1px solid var(--line); border-radius:22px;
  overflow:hidden; box-shadow:0 7px 18px rgba(16,39,68,.06);
}
.head {
  padding:15px 18px; font-size:22px; font-weight:850;
  display:flex; gap:10px; align-items:center; justify-content:space-between;
}
.banorte .head { background:var(--red); color:#fff; }
.mp .head { background:#dff4ff; }
.paypal .head { background:#e6f4ff; color:#073d8c; }
.zelle .head { background:linear-gradient(135deg,#7a2ee6,#5620b8); color:#fff; }
.intl .head { background:var(--navy); color:#fff; }
.body { padding:14px 18px 18px; }
.tag {
  display:inline-flex; gap:7px; flex-wrap:wrap; align-items:center;
  padding:7px 10px; border-radius:999px; background:#f1f4f8;
  font-size:14px; font-weight:800; margin-bottom:10px;
}
.preference {
  margin:4px 0 8px; padding:10px 12px; border-radius:14px;
  background:#fff7df; border:1px solid #ead391; color:#5c4200;
  font-size:14px; line-height:1.35; font-weight:700;
}
.row {
  display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px;
  align-items:center; padding:12px 0; border-top:1px solid #e8ebef;
}
.row.first { border-top:0; }
.label { font-size:13px; color:var(--muted); margin-bottom:3px; }
.value { font-size:19px; font-weight:850; overflow-wrap:anywhere; }
.copy {
  min-width:78px; min-height:44px; padding:10px 12px;
  border:1px solid #a9c9ef; background:#eaf5ff; color:#0f3767;
  border-radius:12px; font-size:14px; font-weight:850; cursor:pointer;
}
.copy:active { transform:scale(.97); }
.copy.done { background:#dff7e5; border-color:#8bc89a; color:#145a28; }
.email-link {
  display:inline-flex; align-items:center; justify-content:center; min-height:44px;
  padding:10px 13px; border-radius:12px; background:#eaf5ff; border:1px solid #a9c9ef;
  color:#0f3767; font-weight:850; text-decoration:none;
}
.intl { grid-column:1/-1; }
.flags { letter-spacing:2px; white-space:nowrap; }
.footer { padding:0 18px 28px; display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.info { background:#fff; border:1px solid var(--line); border-radius:18px; padding:14px 16px; }
.mini { font-size:14px; color:var(--muted); }
.notice {
  margin:0 18px 18px; padding:12px 14px; border-radius:16px;
  background:#f6f8fb; color:#435064; font-size:13px; line-height:1.4;
}
@media (max-width:620px) {
  .grid,.footer { grid-template-columns:1fr; }
  .intl { grid-column:auto; }
  .hero { min-height:250px; }
}

.sender-box {
  margin:18px 18px 0; padding:16px;
  background:#fff; border:1px solid var(--line); border-radius:20px;
  box-shadow:0 7px 18px rgba(16,39,68,.06);
}
.sender-title {
  font-size:20px; font-weight:850; margin:0 0 12px;
}
.sender-grid {
  display:grid; grid-template-columns:1fr 1fr; gap:12px;
}
.field label {
  display:block; font-size:13px; color:var(--muted); font-weight:750; margin:0 0 6px;
}
.field select {
  width:100%; min-height:46px; padding:10px 38px 10px 12px;
  border:1px solid #bfc8d4; border-radius:12px; background:#fff;
  color:var(--ink); font-size:16px; font-weight:700;
}
.sender-summary {
  margin-top:12px; padding:10px 12px; border-radius:12px;
  background:#f6f8fb; color:#435064; font-size:14px; line-height:1.4;
}
@media (max-width:620px) {
  .sender-grid { grid-template-columns:1fr; }
}


.recommended {
  border:2px solid #e0a400 !important;
  box-shadow:0 10px 26px rgba(154,106,0,.18) !important;
}
.recommended::before {
  content:"Preferred";
  display:block;
  padding:7px 12px;
  background:#fff3cd;
  color:#6a4b00;
  font-size:13px;
  font-weight:900;
  text-transform:uppercase;
}
.secondary {
  border:2px solid #b7c4d6 !important;
}
.secondary::before {
  content:"Second choice";
  display:block;
  padding:7px 12px;
  background:#f2f5f8;
  color:#46566b;
  font-size:13px;
  font-weight:900;
  text-transform:uppercase;
}

</style>
</head>
<body>
<div class="wrap">
  <section class="hero">
    <div class="hero-box">
      <h1>BRAD MICHAEL<br>SCALIO</h1>
      <div class="addr">Francisco Rodriguez 336<br>Col. Alta Vista · Puerto Vallarta, Jalisco 48380 · México</div>
    </div>
  </section>

  <section class="sender-box" aria-labelledby="sender-title">
    <div class="sender-title" id="sender-title">What country are you sending money from?</div>
    <div class="sender-grid">
      <div class="field">
        <label for="sender-country">Country / region</label>
        <select id="sender-country">
          <option value="">Choose a country or region</option>
          <option value="USA">USA</option>
          <option value="Mexico">Mexico</option>
          <option value="Canada">Canada</option>
          <option value="European Union">European Union</option>
        </select>
      </div>
      <div class="field">
        <label for="sender-method">Payment method</label>
        <select id="sender-method">
          <option value="">Choose a method</option>
          <option value="Bank account checking">Bank account checking</option>
          <option value="Bank account savings">Bank account savings</option>
          <option value="Debit card">Debit card</option>
          <option value="Credit card">Credit card</option>
          <option value="Zelle-enabled bank account">Zelle-enabled bank account</option>
          <option value="Mobile wallet">Mobile wallet</option>
        </select>
      </div>
    </div>
    <div class="sender-summary" id="sender-summary" aria-live="polite">
      Choose your country/region and payment method to see the preferred way to send.
    </div>
  </section>


  <main class="grid">
    <section class="card banorte" id="card-banorte">
      <div class="head"><span>BANORTE</span><span>🇲🇽</span></div>
      <div class="body">
        <div class="tag">🇲🇽 Mexico → Mexico bank transfers</div>
        <div class="preference">For U.S. bank transfers, please use <strong>Zelle</strong> instead of sending directly to Banorte.</div>
        <div class="row first">
          <div><div class="label">Account holder</div><div class="value">Brad Michael Scalio</div></div>
        </div>
        <div class="row">
          <div><div class="label">CLABE (18 digits)</div><div class="value">072375013163516372</div></div>
          <button class="copy" type="button" data-copy="072375013163516372">Copy</button>
        </div>
      </div>
    </section>

    <section class="card mp" id="card-mp">
      <div class="head"><span>Mercado Pago</span><span class="flags">🇲🇽 🇺🇸</span></div>
      <div class="body">
        <div class="tag">🇲🇽 MX → MX &nbsp;•&nbsp; 🇺🇸 US → MX</div>
        <div class="row first">
          <div><div class="label">Account holder</div><div class="value">Brad Michael Scalio</div></div>
        </div>
        <div class="row">
          <div><div class="label">CLABE (18 digits)</div><div class="value">722969010511776258</div></div>
          <button class="copy" type="button" data-copy="722969010511776258">Copy</button>
        </div>
        <div class="row">
          <div><div class="label">Email</div><div class="value">scalio@gmail.com</div></div>
          <button class="copy" type="button" data-copy="scalio@gmail.com">Copy</button>
        </div>
        <div class="row">
          <div><div class="label">Linked phone</div><div class="value">322 171 6870</div></div>
          <button class="copy" type="button" data-copy="3221716870">Copy</button>
        </div>
      </div>
    </section>

    <section class="card paypal" id="card-paypal">
      <div class="head"><span>PayPal</span><span>💳</span></div>
      <div class="body">
        <div class="tag">Credit cards only</div>
        <div class="row first">
          <div><div class="label">PayPal email</div><div class="value">usefedora@yahoo.com</div></div>
          <button class="copy" type="button" data-copy="usefedora@yahoo.com">Copy</button>
        </div>
      </div>
    </section>

    <section class="card zelle" id="card-zelle">
      <div class="head"><span>Zelle</span><span>🇺🇸</span></div>
      <div class="body">
        <div class="tag">🇺🇸 U.S. banks only · Citibank</div>
        <div class="row first">
          <div><div class="label">Zelle email</div><div class="value">scalio@gmail.com</div></div>
          <button class="copy" type="button" data-copy="scalio@gmail.com">Copy</button>
        </div>
        <div class="preference" style="background:#eaf7ee;border-color:#add2b7;color:#235b32;">Preferred method for transfers from U.S. bank accounts.</div>
      </div>
    </section>

    <section class="card intl" id="card-intl">
      <div class="head">
        <span>Europe / International Transfers</span>
        <span class="flags">🇪🇺 🇮🇹</span>
      </div>
      <div class="body">
        <div class="tag">🇪🇺 Europe &nbsp;•&nbsp; 🇮🇹 Italy</div>
        <div class="row first">
          <div><div class="label">Beneficiary name</div><div class="value">Benedittu Arturo Marcelo Scalia</div></div>
          <button class="copy" type="button" data-copy="Benedittu Arturo Marcelo Scalia">Copy</button>
        </div>
        <div class="row">
          <div><div class="label">Email for international transfer instructions</div><div class="value">scalio@gmail.com</div></div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end">
            <button class="copy" type="button" data-copy="scalio@gmail.com">Copy</button>
            <a class="email-link" href="mailto:scalio@gmail.com?subject=International%20Transfer">Email</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <section class="footer">
    <div class="info">
      <div class="mini">Address</div>
      <div class="value">Francisco Rodriguez 336<br>Col. Alta Vista<br>Puerto Vallarta, Jalisco 48380<br>México</div>
      <button class="copy" style="margin-top:12px" type="button"
        data-copy="Francisco Rodriguez 336, Col. Alta Vista, Puerto Vallarta, Jalisco 48380, México">Copy address</button>
    </div>
    <div class="info">
      <div class="mini">Phone</div>
      <div class="value">322 171 6870</div>
      <button class="copy" style="margin-top:12px" type="button" data-copy="3221716870">Copy phone</button>
    </div>
  </section>

  <div class="notice">
    Tap any <strong>Copy</strong> button to copy that value. The <strong>Email</strong> button opens the device's native mail app.
  </div>
</div>

<script>
(function () {
  async function copyText(text) {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch (e) {}
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.setAttribute("readonly","");
    ta.style.position = "absolute";
    ta.style.left = "-9999px";
    document.body.appendChild(ta);
    ta.select();
    ta.setSelectionRange(0, 99999);
    let ok = false;
    try { ok = document.execCommand("copy"); } catch (e) {}
    document.body.removeChild(ta);
    return ok;
  }


  const country = document.getElementById("sender-country");
  const method = document.getElementById("sender-method");
  const summary = document.getElementById("sender-summary");

  const paymentGrid = document.querySelector(".grid");
  const originalOrder = [
    document.getElementById("card-banorte"),
    document.getElementById("card-mp"),
    document.getElementById("card-paypal"),
    document.getElementById("card-zelle"),
    document.getElementById("card-intl")
  ];

  function resetCards() {
    originalOrder.forEach(card => {
      card.classList.remove("recommended", "secondary");
      paymentGrid.appendChild(card);
    });
  }

  function prioritize(primaryId, secondaryId) {
    resetCards();
    const primary = document.getElementById(primaryId);
    const secondary = secondaryId ? document.getElementById(secondaryId) : null;

    if (secondary) {
      secondary.classList.add("secondary");
      paymentGrid.prepend(secondary);
    }
    primary.classList.add("recommended");
    paymentGrid.prepend(primary);

    requestAnimationFrame(() => {
      primary.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  function updateSenderSummary() {
    const c = country.value;
    const m = method.value;
    resetCards();

    if (!c && !m) {
      summary.innerHTML = "<strong>Choose your country/region and payment method</strong> to see the preferred way to send.";
      return;
    }
    if (c && !m) {
      summary.textContent = "Sending from " + c + ". Now choose the payment method.";
      return;
    }
    if (!c && m) {
      summary.textContent = "Payment method: " + m + ". Now choose the country or region.";
      return;
    }

    const bankMethods = ["Bank account checking", "Bank account savings"];
    const cardMethods = ["Debit card", "Credit card"];

    if (cardMethods.includes(m)) {
      summary.innerHTML = "<strong>Preferred:</strong> Mercado Pago mobile wallet. <strong>Second choice:</strong> PayPal.";
      prioritize("card-mp", "card-paypal");
      return;
    }

    if (c === "USA" && bankMethods.includes(m)) {
      summary.innerHTML =
        "<strong>Preferred:</strong> use Zelle if your U.S. bank account has Zelle enabled. " +
        "If it does not, use my <strong>Mercado Pago mobile wallet</strong>.";
      prioritize("card-zelle", "card-mp");
      return;
    }

    if (c === "USA" && m === "Zelle-enabled bank account") {
      summary.innerHTML = "<strong>Preferred:</strong> Zelle.";
      prioritize("card-zelle");
      return;
    }

    if (c === "Mexico" && bankMethods.includes(m)) {
      summary.innerHTML = "<strong>Preferred:</strong> bank transfer to Banorte.";
      prioritize("card-banorte");
      return;
    }

    if (c === "Mexico" && m === "Mobile wallet") {
      summary.innerHTML = "<strong>Preferred:</strong> Mercado Pago mobile wallet.";
      prioritize("card-mp");
      return;
    }

    if (c === "USA" && m === "Mobile wallet") {
      summary.innerHTML = "<strong>Preferred:</strong> Mercado Pago mobile wallet.";
      prioritize("card-mp");
      return;
    }

    if ((c === "Canada" || c === "European Union") && bankMethods.includes(m)) {
      summary.innerHTML = "<strong>Preferred:</strong> use the Europe / International Transfers section and email me for transfer instructions.";
      prioritize("card-intl");
      return;
    }

    if ((c === "Canada" || c === "European Union") && m === "Mobile wallet") {
      summary.innerHTML = "<strong>Preferred:</strong> Mercado Pago mobile wallet.";
      prioritize("card-mp");
      return;
    }

    if (m === "Zelle-enabled bank account") {
      summary.innerHTML = "<strong>Zelle is for U.S. bank accounts.</strong> Use the international transfer option for this country/region.";
      prioritize("card-intl");
      return;
    }

    summary.innerHTML = "<strong>Preferred:</strong> use the international transfer option below.";
    prioritize("card-intl");
  }

  country.addEventListener("change", updateSenderSummary);
  method.addEventListener("change", updateSenderSummary);


  document.querySelectorAll("[data-copy]").forEach(function(btn) {
    btn.addEventListener("click", async function() {
      const original = btn.textContent;
      const ok = await copyText(btn.getAttribute("data-copy"));
      btn.textContent = ok ? "Copied ✓" : "Select";
      if (ok) btn.classList.add("done");
      setTimeout(function() {
        btn.textContent = original;
        btn.classList.remove("done");
      }, 1500);
    });
  });
})();
</script>
</body>
</html>
